# Copy to .env.local for local development, and set the same values on your host
# (on Vercel: Project Settings -> Environment Variables).
#
# Real values are never committed — .gitignore keeps .env* out, with an
# exception for this template.

# HMZ stock feed. Ask Lemon & Soda UK for credentials.
HMZ_STOCK_URL=https://stockbestand.hmz.nl/StockHMZ/Export_stock.xml
HMZ_STOCK_USER=
HMZ_STOCK_PASSWORD=

# Stock levels are dealer-only and hidden until someone is signed in. There is
# no sign-in yet, so set this to 1 to see the feed working during development.
# Leave it unset in production.
# STOCK_PUBLIC=1
