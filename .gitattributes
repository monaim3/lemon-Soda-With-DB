# Normalise line endings so the repo is identical on macOS, Linux and Windows.
* text=auto eol=lf

# Shell scripts must keep LF or they will not run.
*.sh   text eol=lf
*.command text eol=lf
*.py   text eol=lf

# Binaries — never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.webm binary
*.pdf  binary
*.xlsx binary
*.ico  binary
